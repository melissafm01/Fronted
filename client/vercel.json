{
  "version": 2,
  "routes": [
    {
      "src": "/api/.*",
      "dest": "https://backend-nrpu.onrender.com",
      "headers": {
        "Access-Control-Allow-Origin": "https://fronted-cyan.vercel.app",
        "Access-Control-Allow-Credentials": "true"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/index.html",
      "headers": {
        "Access-Control-Allow-Origin": "https://fronted-cyan.vercel.app",
        "Access-Control-Allow-Credentials": "true"
      }
    }
  ]
}